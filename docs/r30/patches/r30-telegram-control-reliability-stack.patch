+  if (capture.observedReply) missing.push(...observedReplyCaptureIssues(entry));
+  if (capture.sideEffects) missing.push(...sideEffectCaptureIssues(entry));
+  missing.push(...observedNotesCaptureIssues(entry.observed.notes));
