+}
+
+export interface ReliabilityEvalCoverageResult {
+  ok: boolean;
+  requirementCount: number;
+  checkedCaseCount: number;
+  gaps: ReliabilityEvalCoverageGap[];
+}
+
+export const RELIABILITY_EVAL_REQUIREMENTS: ReliabilityEvalRequirement[] = [
