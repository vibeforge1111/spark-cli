+    ],
+    currentScheduleLine: null,
+    currentScheduleUpdatedAt: null,
+    distilledLearningLine: null,
+    nextAction,
+    detailUrl,
+    liveTelegramProven: false,
+    reply: [
+      firstLine,
+      'I did not queue any loop, benchmark, schedule, activation, or publication.',
+      '',
+      `Next safe step: ${nextAction}`,
+      `Spawner: ${detailUrl}`
