+function prioritizeStaleProofCaseIds(caseIds: string[]): string[] {
+  const seen = new Set<string>();
+  return [
+    ...STALE_PROOF_STARTER_CASE_IDS,
+    ...caseIds
+  ].filter((id) => {
+    if (!caseIds.includes(id) || seen.has(id)) return false;
+    seen.add(id);
+    return true;
+  });
+}
