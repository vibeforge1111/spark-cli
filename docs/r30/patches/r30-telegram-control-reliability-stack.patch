-    'List at most 3 candidates, highest confidence first. Confidence is your real certainty, not a constant.',
-    '',
-    'Route taxonomy:',
-    menu
-  ].join('\n');
-  const user = `User's latest message:\n${text}`;
-  return { system, user };
-}
