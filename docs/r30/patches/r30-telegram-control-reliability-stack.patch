+  const normalized = raw.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
+  const mapped = QA_EVIDENCE_LABELS[normalized] || raw.toLowerCase();
+  if (!/^[a-z0-9][a-z0-9 -]{1,60}$/.test(mapped)) return null;
