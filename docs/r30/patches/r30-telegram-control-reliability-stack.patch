+    if (Number.isFinite(nowMs) && generatedMs - nowMs > 5 * 60 * 1000) {
+      invalid.push('packet_generated_at');
+    } else if (
+      isStrictIsoTimestamp(collectedAt) &&
+      generatedMs + 5 * 60 * 1000 < Date.parse(collectedAt)
