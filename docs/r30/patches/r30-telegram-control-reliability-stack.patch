+    `- promote_after_refurbish: ${useCounts.promote_after_refurbish}`,
+    `- run_only_with_intentional_action_confirmation: ${useCounts.run_only_with_intentional_action_confirmation}`,
+    '',
+    '## Mutation Classes',
+    '',
+    `- none: ${mutationCounts.none}`,
