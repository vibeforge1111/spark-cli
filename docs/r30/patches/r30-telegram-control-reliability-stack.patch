+});
+
+async function run() {
+  for (const entry of tests) {
+    await entry.fn();
+    console.log(`ok - ${entry.name}`);
+  }
+}
+
+run().catch((error) => {
+  console.error(error);
+  process.exit(1);
+});
diff --git a/tests/r30LiveTelegramSummary.test.ts b/tests/r30LiveTelegramSummary.test.ts
